# This service definition provides the capabilities report for a device_if_sim
# connector node (see docs/SIMULATION_INTERFACE_SPEC.md). Mirrors
# nepi_interfaces/RBXCapabilitiesQuery.srv's existing fields unchanged (reused
# as-is, per the spec's data flow contract), plus the new device_if_sim fields
# below it.

---
string device_name
string device_path
string device_node_name

# Commanded controls for fields set to False will be ignored
nepi_interfaces/AxisControls control_support

bool has_battery_feedback

bool has_manual_controls
bool has_autonomous_controls
bool has_set_home
bool has_go_home
bool has_go_stop
bool has_goto_pose
bool has_goto_position
bool has_goto_location

string[] state_options
string[] mode_options
string[] setup_action_options
string[] go_action_options

string[] data_products

##############################
# device_if_sim additions (docs/SIMULATION_INTERFACE_SPEC.md,
# "New capability/status fields this device type needs")

# Distinguishes a ground vehicle from a flight vehicle for UI layout purposes
bool has_wheels
int32 wheel_count

# Generic motor-output capability -- effectively has_manual_controls, named
# explicitly for clarity to a non-RBX-familiar reader
bool has_motors
int32 motor_count

# Typed sensor-topic list (decided 2026-08-04, see SensorTopicInfo.msg) --
# every sensor topic the simulator currently exposes, not just cameras
SensorTopicInfo[] available_sensor_topics

# Derived from available_sensor_topics (msg_type == 'sensor_msgs/Image'),
# never independently tracked -- see api/device_if_sim.py
bool has_camera
string[] available_image_topics
string active_image_topic

# Camera view/rig control (follow angle, distance) -- distinct from which
# image topic is active
bool has_camera_view_control
string[] available_camera_view_modes

# Whether the world/environment can be reconfigured live (e.g. obstacle
# course toggle), distinct from RESET_SIM which only resets the existing world
bool has_environment_controls
string[] available_environment_options
