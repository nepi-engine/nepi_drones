<?xml version="1.0"?>
<package format="2">
  <name>nepi_app_sim_connector</name>
  <version>0.0.0</version>
  <description>Generic NEPI simulator connector app. Hosts one SimDeviceIF and the one well-known TCP/JSON connection surface any simulator's own bridge script dials into.</description>

  <maintainer email="nepi@numurus.com">numurus</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>geographic_msgs</build_depend>
  <build_depend>nepi_interfaces</build_depend>
  <build_depend>message_generation</build_depend>

  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>nepi_interfaces</build_export_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>nepi_interfaces</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>message_runtime</exec_depend>

  <export>
  </export>
</package>
