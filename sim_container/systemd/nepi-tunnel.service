# Persistent reverse SSH tunnel from this dev VM to the NEPI device.
#
# WHY THIS EXISTS: nepi_tunnel() in ../scripts/nepi_sitl_dev_env.sh starts
# autossh with plain `nohup ... &`, which dies with the VM and is never
# restarted. Confirmed the hard way twice: after a VM reboot, every sim
# connector Deploy failed with
#   "Launch ssh session exited 255 within 5s: ssh: connect to host
#    127.0.0.1 port 12222: Connection refused"
# because the device SSHes BACK to this VM through the 12222 forward to run
# each launch_command (see simulator_launcher.py's _ssh_cmd), and that
# forward only exists while the tunnel process is alive. Restarting it by
# hand fixes the symptom until the next reboot; this unit fixes the cause.
#
# Installed as a USER service (systemctl --user) rather than a system one so
# it needs no root: the SSH key it uses lives in this user's own ~/.ssh.
# Requires `loginctl enable-linger <user>` so it starts at boot instead of
# waiting for an interactive login -- without linger this unit still works,
# but only once the user logs in, which defeats the point.
#
# Install/refresh:
#   mkdir -p ~/.config/systemd/user
#   cp nepi-tunnel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now nepi-tunnel.service
#   loginctl enable-linger $(id -un)      # may prompt for sudo/polkit once
#
# Check:  systemctl --user status nepi-tunnel.service
# Logs:   journalctl --user -u nepi-tunnel.service -f
#
# The forwarded ports must stay in sync with nepi_tunnel() in
# ../scripts/nepi_sitl_dev_env.sh -- that function remains the documented
# reference for what each port is for (5760/5771 MAVLink, 9021-9028 the
# sim-utility listeners and bridges, 9041/9046 the Webots rover RBX bridge's
# heartbeat/bridge ports, 9042/9047 the Webots quadcopter RBX bridge's,
# 12222 this VM's own sshd).

[Unit]
Description=NEPI reverse SSH tunnel to device (MAVLink, sim bridges, and VM sshd for sim connector launches)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# autossh's own monitoring port is disabled (-M 0) in favour of SSH-level
# keepalives (ServerAliveInterval/CountMax), matching nepi_tunnel()'s own
# invocation -- -M would need a second free port pair and adds nothing here.
# GATETIME=0 tells autossh not to give up when the very first connection
# attempt fails, which is the normal case at boot (the device may be down,
# or slower to come up than this VM) and the whole reason for using autossh
# rather than plain ssh.
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -p 2222 \
  -i /home/suraj/.ssh/nepi_default_ssh_key \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o ExitOnForwardFailure=yes \
  -o ConnectTimeout=5 \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 \
  -N \
  -R 5760:127.0.0.1:5760 \
  -R 5771:127.0.0.1:5771 \
  -R 9021:127.0.0.1:9021 \
  -R 9022:127.0.0.1:9022 \
  -R 9023:127.0.0.1:9023 \
  -R 9024:127.0.0.1:9024 \
  -R 9025:127.0.0.1:9025 \
  -R 9026:127.0.0.1:9026 \
  -R 9027:127.0.0.1:9027 \
  -R 9028:127.0.0.1:9028 \
  -R 9041:127.0.0.1:9041 \
  -R 9042:127.0.0.1:9042 \
  -R 9046:127.0.0.1:9046 \
  -R 9047:127.0.0.1:9047 \
  -R 12222:127.0.0.1:22 \
  nepi@nepi
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
